# 复制为 .env 后按实际填写；.env 已在 .gitignore 中，禁止提交真实密钥。
# Spring Boot 本身不读取 .env 文件：需用 scripts/load-env.ps1 加载，或在 IDEA 运行配置的
# Environment variables / 服务器环境变量中注入。

# 运行环境：dev / prod
SPRING_PROFILES_ACTIVE=dev

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rong_pet_test
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# 敏感字段加解密（生产必填；AES 密钥 Base64 解码后必须为 32 字节）
RONGPET_CRYPTO_AES_KEY=
RONGPET_CRYPTO_HMAC_KEY=

# 微信小程序
WX_MA_APPID=
WX_MA_SECRET=

# 微信支付（个体工商户商户号）
WX_PAY_APPID=
WX_PAY_MCH_ID=
WX_PAY_MCH_KEY=
WX_PAY_API_V3_KEY=
WX_PAY_CERT_SERIAL=
WX_PAY_PRIVATE_KEY_PATH=
WX_PAY_NOTIFY_URL=https://api.example.com/callback

# 腾讯云 COS（私有 bucket）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_PREFIX=rong-pet

# Druid 监控面板口令（仅 dev 生效，prod 面板关闭）
DRUID_CONSOLE_USER=druid
DRUID_CONSOLE_PASSWORD=

# dev 环境默认管理员（仅 dev profile 的 DevAdminInitializer 使用）
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=

# 本地 mock 与上传兜底开关
WX_MA_MOCK=true
WX_PAY_MOCK=true
UPLOAD_LOCAL_ENABLED=true

# 生产数据库与缓存（prod profile，与上面同名变量复用，按环境填不同值）
# MYSQL_HOST / MYSQL_PORT / MYSQL_DATABASE / MYSQL_USERNAME / MYSQL_PASSWORD
# REDIS_HOST / REDIS_PORT / REDIS_DATABASE / REDIS_PASSWORD
