# 复制为 .env 后按实际填写；.env 已在 .gitignore 中，禁止提交真实密钥。
# 本地 dev profile 已内置仅用于联调的加密密钥，以下变量主要供生产/测试环境使用。

# 运行环境：dev / prod
SPRING_PROFILES_ACTIVE=dev

# 敏感字段加解密（生产必填；AES 密钥 Base64 解码后必须为 32 字节）
RONGPET_CRYPTO_AES_KEY=
RONGPET_CRYPTO_HMAC_KEY=

# 微信小程序
WX_MA_APPID=
WX_MA_SECRET=

# 微信支付（个体工商户商户号）
WX_PAY_APPID=
WX_PAY_MCH_ID=
WX_PAY_MCH_KEY=
WX_PAY_API_V3_KEY=
WX_PAY_CERT_SERIAL=
WX_PAY_PRIVATE_KEY_PATH=
WX_PAY_NOTIFY_URL=https://api.example.com/callback

# 腾讯云 COS（私有 bucket）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-chengdu
COS_BUCKET=
COS_PREFIX=rong-pet

# 生产数据库与缓存（prod profile）
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=rong_pet
MYSQL_USERNAME=
MYSQL_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
